{
  "name": "bili-duty",
  "version": "0.1.3",
  "license": "MIT",
  "description": "刷B站值班表：定时唤醒某个会话去扫 B 站、读字幕与评论挑出值得看的、写一份日报、维护判重表 —— 判断留给会话里的 AI，插件只做调度、配置与记录",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k423Charotte/bili-duty.git"
  },
  "homepage": "https://github.com/k423Charotte/bili-duty#readme",
  "bugs": {
    "url": "https://github.com/k423Charotte/bili-duty/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "schedule",
    "duty",
    "automation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "prompts",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tools"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node tools/smoke-test.mjs",
    "test:client": "node tools/client-smoke-test.mjs",
    "test:qr": "node tools/qr-test.mjs",
    "check:new-user": "node tools/new-user-check.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
